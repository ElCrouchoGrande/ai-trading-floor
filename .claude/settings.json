{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.git/objects/**)",
      "Read(./.git/logs/**)",
      "Read(./**/__pycache__/**)",
      "Read(./**/*.pyc)",
      "Read(./**/*.db)",
      "Read(./**/*.sqlite)",
      "Read(./**/*.sqlite3)",
      "Read(./.venv/**)",
      "Read(./venv/**)",
      "Read(./node_modules/**)",
      "Read(./.pytest_cache/**)",
      "Read(./.mypy_cache/**)",
      "Read(./.ruff_cache/**)",
      "Bash(git push --force*:*)"
    ],
    "allow": [
      "Bash(python -m py_compile:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(ls:*)",
      "Bash(wc:*)"
    ]
  }
}
