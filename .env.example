# Postgres connection string. Railway injects this automatically when you
# add a Postgres plugin to the project; set manually only for local dev.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Claude API key (Anthropic console). Used by analyst, traders, and debate
# engine. All three call claude-sonnet-4-20250514.
ANTHROPIC_API_KEY=sk-ant-...

# Bearer token for /inject, /portfolio, /report/latest, /weekly/preview.
# REQUIRED for admin endpoints: leaving this as "changeme" (or unset) disables
# them entirely (503) so a public deploy can't be abused. Set a long random
# value and pass it as the X-Admin-Token header when you curl the endpoints.
ADMIN_TOKEN=changeme

# Railway sets PORT automatically. Local dev only.
PORT=8000

# Token-spend controls for the scheduled analyst pipeline.
# Cooldown: skip a ticker if it already has a report newer than this (hours).
# Set to 0 to disable. Manual /inject always bypasses.
ANALYST_COOLDOWN_HOURS=12
# Hard cap on tickers analysed per scheduled trigger run.
MAX_TICKERS_PER_RUN=5

# SEC EDGAR asks API clients to identify themselves with a contact address.
# Set this to an address you monitor.
SEC_CONTACT_EMAIL=you@example.com
